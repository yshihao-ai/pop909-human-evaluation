        },
        {
          "id": "long_term_development",
          "label": "长程发展合理性（Long-Term Development）",
          "description": "作品是否具有合理的段落变化、张弛和发展，同时避免机械重复或无逻辑跳变。"
        },
        {
          "id": "latter_half_quality",
          "label": "后半段音乐质量（Latter-Half Musical Quality）",
          "description": "后半段本身是否自然、完整，是否出现空轨、音符堆积、节奏失控或明显质量退化。"
        }
      ],
