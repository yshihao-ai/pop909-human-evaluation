      "title": "POP909 伴奏生成",
      "short_description": "完整试听 16 个 4/4 小节的旋律与生成伴奏，评价旋律伴奏协调性、和声合理性、节奏一致性、音乐正确性与整体质量。",
      "rules_markdown": "/rules/accompaniment.md",
      "metrics": [
        {
          "id": "coherence",
          "label": "旋律与伴奏协调性（Melody–Accompaniment Coherence）",
          "description": "伴奏与给定旋律是否协调，能否自然、合理地配合并支持旋律。"
        },
        {
          "id": "harmony",
          "label": "和声合理性（Harmonic Appropriateness）",
          "description": "伴奏是否符合给定和弦进行，是否存在明显的和声音高冲突。"
        },
        {
          "id": "rhythmic_consistency",
          "label": "节奏一致性（Rhythmic Consistency）",
          "description": "伴奏的节奏型、节奏密度、速度感和律动是否连续、稳定，是否存在卡顿、突变或节奏失控。"
        },
        {
          "id": "accompaniment_pattern_stability",
          "label": "伴奏型稳定性（Accompaniment-Pattern Stability）",
          "description": "伴奏型及其织体组织是否清晰、稳定，重复与变化是否自然连贯，是否存在无逻辑的伴奏型切换。"
        },
        {
          "id": "correctness",
          "label": "音乐正确性（Musical Correctness）",
          "description": "是否存在不合理的不协和音、异常节奏、不自然乐句等明显音乐错误。"
        },
        {
          "id": "overall",
          "label": "整体质量（Overall Quality）",
          "description": "综合评价伴奏的自然度、流畅性、协调性与对当前旋律的适合程度。"
        }
      ],
