  "tasks": [
    {
      "task_type": "continuation",
      "title": "POP909 音乐续写",
      "short_description": "在 POP909 上先试听 GT 原曲参考，再比较各方法的续写结果。每个 Sample 的前 4 小节为固定 Prompt，后 12 小节为各方法生成的续写部分；请评价衔接、稳定性、和声与整体质量。",
      "rules_markdown": "/rules/continuation.md",
      "metrics": [
        {
          "id": "coherence",
          "label": "连贯性（Coherence）",
          "description": "续写与给定 4 小节 Prompt 的衔接是否自然，前后音乐风格是否一致。"
        },
        {
          "id": "consistency",
          "label": "节奏一致性（Rhythmic Consistency）",
          "description": "续写部分自身的节奏型、节奏密度和速度感是否连续、稳定，并兼顾音乐进行中是否存在卡顿或突变。"
        },
        {
          "id": "harmony",
          "label": "和声合理性（Harmony）",
          "description": "续写部分的音高与和声是否自然协调，是否存在冲突或异常音程。"
        },
        {
          "id": "overall",
          "label": "整体质量（Overall Quality）",
          "description": "综合评价续写的自然度、流畅性、协调性、音乐性与整体听感。"
        }
      ],
