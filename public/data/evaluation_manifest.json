    {
      "task_type": "chord_conditioned",
      "title": "POP909 给定和弦生成",
      "short_description": "先试听 GT 原曲参考，再比较 DID 原始力度、DID-80 与 FGG-80 在相同和弦条件下生成的约 32 秒音乐，评价和弦遵循、旋律、节奏、结构与整体质量。",
      "rules_markdown": "/rules/chord-conditioned.md",
      "metrics": [
        {
          "id": "chord_adherence",
          "label": "和弦条件遵循性（Chord-Condition Adherence）",
          "description": "生成音乐的和声进行是否与给定和弦条件及 GT 参考保持一致，是否出现明显偏离或错误和弦。"
        },
        {
          "id": "melodic_quality",
          "label": "旋律质量（Melodic Quality）",
          "description": "生成旋律是否自然、流畅且具有音乐性，是否存在生硬跳进、无意义游走或明显断裂。"
        },
        {
          "id": "rhythmic_consistency",
          "label": "节奏一致性（Rhythmic Consistency）",
          "description": "节奏型、节奏密度、速度感和律动是否连续稳定，是否存在卡顿、突变或节奏失控。"
        },
        {
          "id": "structural_coherence",
          "label": "音乐结构完整性（Structural Coherence）",
          "description": "约 32 秒音乐是否形成连贯、完整的乐句和段落，发展与收束是否自然。"
        },
        {
          "id": "overall",
          "label": "整体质量（Overall Quality）",
          "description": "综合评价生成音乐的自然度、协调性、完整性、音乐性与整体听感。"
        }
      ],
