  "tasks": [
    {
      "task_type": "continuation",
      "title": "POP909 音乐续写",
      "short_description": "在 POP909 上先试听 GT 原曲参考，再比较各方法保留原始 4 小节 Prompt 与后续 12 小节续写的结果，评价衔接、稳定性、和声与整体质量。",
      "rules_markdown": "/rules/continuation.md",
      "metrics": [
        {
          "id": "coherence",
          "label": "Coherence",
          "description": "续写与给定 4 小节 Prompt 的衔接是否自然，前后音乐风格是否一致。"
        },
        {
          "id": "consistency",
          "label": "Consistency",
          "description": "续写部分自身在节奏和音乐进行上是否连续、稳定，是否存在卡顿或突变。"
        },
        {
          "id": "harmony",
          "label": "Harmony",
          "description": "续写部分的音高与和声是否自然协调，是否存在冲突或异常音程。"
        },
        {
          "id": "overall",
          "label": "Overall",
          "description": "综合评价续写的自然度、流畅性、协调性、音乐性与整体听感。"
        }
      ],
